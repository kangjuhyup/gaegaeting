{
  "name": "Gaegaeting integration branch policy",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/main",
        "refs/heads/dev/**/*",
        "refs/heads/release/**/*"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "pull_request",
      "parameters": {
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_approving_review_count": 0,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": true,
        "required_status_checks": [
          {
            "context": "branch-policy",
            "integration_id": 15368
          },
          {
            "context": "service-verification",
            "integration_id": 15368
          },
          {
            "context": "image-account",
            "integration_id": 15368
          },
          {
            "context": "image-match",
            "integration_id": 15368
          },
          {
            "context": "image-payment",
            "integration_id": 15368
          },
          {
            "context": "image-gateway",
            "integration_id": 15368
          },
          {
            "context": "image-edge-authz",
            "integration_id": 15368
          },
          {
            "context": "image-integration-ui",
            "integration_id": 15368
          },
          {
            "context": "image-admin-ui",
            "integration_id": 15368
          }
        ]
      }
    },
    {
      "type": "non_fast_forward"
    }
  ]
}
