{
  "name": "challenge",
  "version": "0.0.1",
  "description": "산책 챌린지 참여와 실적 서비스",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.13.1 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "node dist/src/main.js",
    "migration:run": "node dist/src/migrations/migrate.js",
    "test": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest",
    "format": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "@apollo/server": "^5.2.0",
    "@apollo/subgraph": "^2.12.1",
    "@as-integrations/express5": "^1.1.2",
    "@core/auth": "workspace:*",
    "@core/database": "workspace:*",
    "@core/logger": "workspace:*",
    "@mikro-orm/decorators": "7.1.14",
    "@nestjs/apollo": "^13.2.1",
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.2.3",
    "@nestjs/graphql": "^13.2.0",
    "@nestjs/platform-express": "^11.2.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "graphql": "^16.12.0",
    "joi": "^17.13.3",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "ulid": "^3.0.1",
    "@core/storage": "workspace:*",
    "@core/auth-assertion": "workspace:*",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@nestjs/testing": "^11.2.3",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/supertest": "^6.0.0",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "prettier": "^3.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.8.3",
    "@types/pngjs": "6.0.5"
  },
  "files": [
    "dist"
  ]
}
