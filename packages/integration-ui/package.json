{
  "name": "@gaegaeting/integration-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite --host 0.0.0.0",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "dev:flutter": "fvm flutter run -d chrome --web-port=5173",
    "build:flutter": "fvm flutter build web --release",
    "analyze:flutter": "fvm flutter analyze",
    "test:flutter": "fvm flutter test",
    "generate:flutter": "fvm dart run build_runner build"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@gaegaeting/ui-common": "workspace:*",
    "graphql-ws": "6.0.6",
    "graphql": "^16.12.0"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.8.3",
    "vite": "6.1.0"
  }
}
