{
  "name": "gateway",
  "version": "0.0.1",
  "description": "Apollo Federation Gateway",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc",
    "test": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --runInBand",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "ts-node src/main.ts",
    "start:local": "ts-node src/main.ts",
    "start:dev": "doppler run -- ts-node src/main.ts",
    "start:debug": "ts-node --inspect src/main.ts",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix"
  },
  "dependencies": {
    "@apollo/gateway": "^2.6.0",
    "@apollo/server": "^5.2.0",
    "@as-integrations/express5": "^1.1.2",
    "@core/auth-assertion": "workspace:*",
    "body-parser": "^2.2.1",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "graphql": "^16.12.0"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@types/body-parser": "^1.19.6",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.1",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "files": [
    "dist"
  ]
}
