# 실제 키와 계정 값을 채운 뒤 .env로 복사한다. 운영 비밀은 비밀 저장소에서 주입한다.
# 테스트 결제 서버용이다. 운영은 NODE_ENV=production, PAYMENT_STORE_ENVIRONMENT=Production.
NODE_ENV=development
PAYMENT_SERVICE_API_PORT=2802
PAYMENT_STORE_ENVIRONMENT=Sandbox
PAYMENT_WORKER_ENABLED=true

# Payment 전용 DB. migration:run에도 같은 환경을 별도로 주입한다.
PAYMENT_DATABASE_URL=
DATABASE_SSL_MODE=disable
# Gateway와 동일한 32자 이상의 비밀.
INTERNAL_AUTH_ASSERTION_SECRET=
# 32바이트 암호화 키의 64자리 hex. 최초 생성 후 유지한다.
PAYMENT_PROOF_ENCRYPTION_KEY=

# 등록된 Apple 소모성 상품. ID가 다르면 DB 스토어 매핑도 함께 변경한다.
PAYMENT_APPLE_ENABLED=true
PAYMENT_APPLE_BUNDLE_ID=
PAYMENT_APPLE_APP_ID=
PAYMENT_APPLE_KEY_ID=
PAYMENT_APPLE_ISSUER_ID=
PAYMENT_APPLE_SIGNING_KEY_PATH=
PAYMENT_APPLE_ROOT_CERT_PATHS=
PAYMENT_APPLE_PRODUCT_IDS=app.gaegaeting.snacks.10,app.gaegaeting.snacks.50,app.gaegaeting.snacks.100

# 등록된 Google 일회성 상품. 조회·consume용 ADC 또는 아래 서비스 계정 파일을 사용한다.
PAYMENT_GOOGLE_ENABLED=true
PAYMENT_GOOGLE_PACKAGE_NAME=
GOOGLE_APPLICATION_CREDENTIALS=
# 인증된 Pub/Sub push 구독과 정확히 일치시킨다.
PAYMENT_GOOGLE_PUSH_AUDIENCE=
PAYMENT_GOOGLE_PUSH_SERVICE_ACCOUNT_EMAIL=
PAYMENT_GOOGLE_PRODUCT_IDS=app.gaegaeting.snacks.10,app.gaegaeting.snacks.50,app.gaegaeting.snacks.100

# 이 값은 별도로 Gateway 실행 환경에 설정한다.
# PAYMENT_SERVICE_URL=http://127.0.0.1:2802/payment/graphql
