+          value: /etc/database/ca.crt
+        - name: DATABASE_HOST
+          valueFrom:
+            secretKeyRef:
+              name: gaegaeting-chat-runtime
+              key: DATABASE_HOST
+        - name: DATABASE_PORT
+          valueFrom:
+            secretKeyRef:
+              name: gaegaeting-chat-runtime
+              key: DATABASE_PORT
+        - name: DATABASE_USERNAME
+          valueFrom:
+            secretKeyRef:
+              name: gaegaeting-chat-runtime
+              key: DATABASE_USERNAME
+        - name: DATABASE_PASSWORD
+          valueFrom:
+            secretKeyRef:
+              name: gaegaeting-chat-runtime
+              key: DATABASE_PASSWORD
+        - name: DATABASE_NAME
+          valueFrom:
+            secretKeyRef:
+              name: gaegaeting-chat-runtime
+              key: DATABASE_NAME
+        - name: DATABASE_SSL_MODE
+          valueFrom:
+            secretKeyRef:
+              name: gaegaeting-chat-runtime
+              key: DATABASE_SSL_MODE
+        volumeMounts:
+        - name: db-ca
+          mountPath: /etc/database
+          readOnly: true
+        workingDir: /app
