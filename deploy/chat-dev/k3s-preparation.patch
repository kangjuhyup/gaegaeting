@@ -0,0 +1,78 @@
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: chat
+  namespace: gaegaeting-dev
+  annotations:
+    argocd.argoproj.io/sync-wave: '10'
+spec:
+  selector:
+    matchLabels:
+      app.kubernetes.io/name: chat
+      app.kubernetes.io/part-of: gaegaeting
+  template:
+    metadata:
+      labels:
+        app.kubernetes.io/name: chat
+        app.kubernetes.io/part-of: gaegaeting
+      annotations:
+        sidecar.istio.io/inject: 'false'
+    spec:
+      automountServiceAccountToken: false
+      securityContext:
+        runAsNonRoot: true
+        runAsUser: 1000
+        runAsGroup: 1000
+        fsGroup: 1000
+        seccompProfile:
+          type: RuntimeDefault
+      containers:
+      - name: chat
+        image: ghcr.io/kangjuhyup/gaegaeting/chat:sha-CHAT_RELEASE_SHA@sha256:CHAT_IMAGE_DIGEST
+        ports:
+        - name: http
+          containerPort: 2804
+        envFrom:
+        - secretRef:
+            name: gaegaeting-chat-runtime
+        securityContext:
+          allowPrivilegeEscalation: false
+          capabilities:
+            drop:
+            - ALL
+        startupProbe:
+          httpGet:
+            path: /chat/health
+            port: http
+          failureThreshold: 60
+          periodSeconds: 5
+        readinessProbe:
+          httpGet:
+            path: /chat/health/ready
+            port: http
+          periodSeconds: 10
+          timeoutSeconds: 6
+        livenessProbe:
+          httpGet:
+            path: /chat/health
+            port: http
+          periodSeconds: 20
+          failureThreshold: 3
+        env:
+        - name: NODE_EXTRA_CA_CERTS
+          value: /etc/database/ca.crt
+        volumeMounts:
+        - name: db-ca
+          mountPath: /etc/database
+          readOnly: true
+        resources:
+          requests:
+            cpu: 25m
+            memory: 256Mi
+          limits:
+            memory: 512Mi
+      volumes:
+      - name: db-ca
+        secret:
+          secretName: gaegaeting-db-ca
+  replicas: 0
